---
// Installer links point at the releases page until the script finds the exact files of the latest release.
import { links } from '../lib/site';

const platforms = [
  {
    id: 'windows',
    name: 'Windows',
    files: [
      { label: 'Installer (.exe)', match: '_x64-setup\\.exe$', primary: true },
      { label: 'MSI package', match: '\\.msi$' },
    ],
    note: 'Builds are not code-signed yet. If SmartScreen says “Windows protected your PC”, choose More info, then Run anyway.',
  },
  {
    id: 'macos',
    name: 'macOS',
    files: [
      { label: 'Apple silicon (.dmg)', match: '_aarch64\\.dmg$', primary: true },
      { label: 'Intel (.dmg)', match: '_x64\\.dmg$' },
    ],
    note: 'If macOS reports the app as damaged, run this once:',
    code: 'xattr -dr com.apple.quarantine "/Applications/Repo Board.app"',
  },
  {
    id: 'linux',
    name: 'Linux',
    files: [
      { label: 'AppImage', match: '\\.AppImage$', primary: true },
      { label: '.deb', match: '\\.deb$' },
      { label: '.rpm', match: '\\.rpm$' },
    ],
    note: 'AppImage runs on most distributions. Use .deb on Debian and Ubuntu, .rpm on Fedora and openSUSE.',
  },
];
---

<section id="download" class="download" aria-labelledby="download-title">
  <div class="wrap">
    <h2 id="download-title" class="h2">Download Repo Board</h2>
    <p class="lede">
      Free and open source. The only requirement is <a href="https://git-scm.com">git</a> on your PATH.
      <span data-version></span>
    </p>

    <div class="platforms">
      {
        platforms.map((p) => (
          <div class="platform" data-platform={p.id}>
            <h3 class="h3">{p.name}</h3>
            <ul>
              {p.files.map((f) => (
                <li>
                  <a class={f.primary ? 'btn btn-primary' : 'btn btn-ghost'} href={links.releases} data-asset={f.match}>
                    {f.label}
                  </a>
                </li>
              ))}
            </ul>
            <p class="note">
              {p.note}
              {p.code && <code class="cmd">{p.code}</code>}
            </p>
          </div>
        ))
      }
    </div>

    <p class="alt">
      Live in VS Code? <a href={links.extension}>Get the extension from the Marketplace</a>. Every release and its notes are
      on <a href={links.releases}>GitHub</a>.
    </p>
  </div>
</section>

<script>
  type Asset = { name: string; browser_download_url: string };
  type Release = { tag_name: string; assets: Asset[] };

  const ua = navigator.userAgent;
  const os = /Windows/i.test(ua) ? 'windows' : /Mac/i.test(ua) ? 'macos' : /Linux|X11/i.test(ua) && !/Android/i.test(ua) ? 'linux' : null;
  const names: Record<string, string> = { windows: 'Windows', macos: 'macOS', linux: 'Linux' };

  // Put the visitor's platform first and say so on the hero button.
  if (os) {
    const card = document.querySelector<HTMLElement>(`[data-platform="${os}"]`);
    card?.classList.add('mine');
    card?.parentElement?.prepend(card);
    const label = document.querySelector('[data-hero-label]');
    if (label) label.textContent = `Download for ${names[os]}`;
  }

  async function load() {
    try {
      const res = await fetch('https://api.github.com/repos/kasuken/repoboard/releases/latest', {
        headers: { Accept: 'application/vnd.github+json' },
      });
      if (!res.ok) return;
      const release = (await res.json()) as Release;
      document.querySelectorAll<HTMLAnchorElement>('[data-asset]').forEach((a) => {
        const re = new RegExp(a.dataset.asset!, 'i');
        const hit = release.assets.find((x) => re.test(x.name));
        if (hit) a.href = hit.browser_download_url;
      });
      const v = document.querySelector('[data-version]');
      if (v) v.textContent = `Latest version: ${release.tag_name.replace(/^v/, '')}.`;

      // On Windows the hero button can download straight away; elsewhere it opens the choice of builds.
      if (os === 'windows') {
        const exe = document.querySelector<HTMLAnchorElement>('[data-platform="windows"] .btn-primary');
        const hero = document.querySelector<HTMLAnchorElement>('[data-hero-download]');
        if (exe && hero && exe.href.endsWith('.exe')) hero.href = exe.href;
      }
    } catch {
      // Offline or rate-limited: the links keep pointing at the releases page.
    }
  }
  load();
</script>

<style>
  .download {
    background: var(--ink-2);
  }
  .platforms {
    display: grid;
    gap: 20px;
    margin-top: 48px;
  }
  @media (min-width: 900px) {
    .platforms {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .platform {
    min-width: 0;
    padding: 28px;
    border: 2px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--ink);
    display: flex;
    flex-direction: column;
  }
  .platform.mine {
    border-color: var(--ahead);
  }
  .platform ul {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .platform .btn {
    min-height: 46px;
    font-size: 1rem;
  }
  .note {
    margin: auto 0 0;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .cmd {
    display: block;
    margin-top: 8px;
    padding: 10px 12px;
    background: #0f0c15;
    border-radius: var(--radius-s);
    overflow-x: auto;
    white-space: nowrap;
    color: var(--paper);
    user-select: all;
  }
  .alt {
    margin: 36px 0 0;
    color: var(--muted);
  }
  .alt a,
  .lede a {
    color: var(--paper);
    text-underline-offset: 4px;
  }
</style>
