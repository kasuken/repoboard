---
import '@fontsource-variable/anybody/standard.css';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import anybodyLatin from '@fontsource-variable/anybody/files/anybody-latin-standard-normal.woff2?url';
import { absolute, url, meta, links, faqs } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}
const { title = meta.title, description = meta.description } = Astro.props;
const canonical = absolute(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), ''));
const ogImage = absolute('og.png');

const software = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: meta.name,
  description: meta.description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows, macOS, Linux',
  url: absolute(),
  downloadUrl: links.releases,
  image: ogImage,
  screenshot: absolute('og.png'),
  license: 'https://opensource.org/licenses/MIT',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Emanuele Bartolesi', url: 'https://github.com/kasuken' },
  sameAs: [links.repo, links.extension, links.extensionRepo],
};
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#17131f" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" sizes="96x96" href={url('icon-96.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <link rel="preload" href={anybodyLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Repo Board: a wall of repositories coloured by git state" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(software)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqPage)} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <slot />
  </body>
</html>
